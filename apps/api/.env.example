# VidyaGram API configuration (copy to .env for local development).
# Never commit real secrets. This file contains development defaults only.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# SQLite file. Relative paths resolve from apps/api.
DATABASE_PATH=./data/vidyagram.db

# Comma-separated browser origins allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:5173,http://localhost:4173

# Demo controls. Set DEMO_MODE=false for a real school deployment.
DEMO_MODE=true
SEED_ON_BOOT=true

# Session lifetime in days.
SESSION_DAYS=7

# Trust the reverse proxy in front of the API (set true in production).
TRUST_PROXY=false
