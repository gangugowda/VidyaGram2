{
  "name": "vidyagram",
  "version": "0.2.0",
  "private": true,
  "description": "VidyaGram — multilingual learning platform for government schools. Monorepo: web app + API.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @vidyagram/api",
    "dev:web": "npm run dev -w @vidyagram/web",
    "build": "npm run build -w @vidyagram/web && npm run build -w @vidyagram/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @vidyagram/api",
    "lint": "npm run typecheck",
    "db:reset": "npm run db:reset -w @vidyagram/api",
    "db:seed": "npm run db:seed -w @vidyagram/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
